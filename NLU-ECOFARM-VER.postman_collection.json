							"const body = pm.response.json();",
							"pm.test('Day du cac thanh phan proof bundle', function () {",
							"    pm.expect(body.batchCode).to.eql('BATCH-2026-001');",
							"    pm.expect(body.batchIdHash).to.match(/^0x[0-9a-f]{64}$/i);",
