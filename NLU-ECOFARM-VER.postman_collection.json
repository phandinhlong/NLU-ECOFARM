							"    pm.expect(body.leaves).to.be.an('array');",
							"    pm.expect(body.events).to.be.an('array');",
							"    pm.expect(body.selfCheckScript).to.include('keccak256');",
							"});",
							"pm.test('Su kien da khu thong tin ca nhan (khong co recordedBy)', function () {",
							"    const raw = pm.response.text();",
