  "item": [
    {
      "name": "Authentication",
      "description": "Authentication endpoints (/api/v1/auths)",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}"
            },
            "description": "Register a new user account",
            "url": {
              "raw": "{{baseurl}}/api/v1/auths/sign-up",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "api",
                "v1",
                "auths",
                "sign-up"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Activate User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "description": "Activate user account using activation token",
            "url": {
              "raw": "{{baseurl}}/api/v1/auths/activation?token={{activationToken}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "api",
                "v1",
                "auths",
                "activation"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{activationToken}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res && res.data) {",
                  "        if (res.data.accessToken) pm.collectionVariables.set('access_token', res.data.accessToken);",
                  "        if (res.data.refreshToken) pm.collectionVariables.set('refresh_token', res.data.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Authenticate user and store access_token & refresh_token in collection variables and cookies",
            "url": {
              "raw": "{{baseurl}}/api/v1/auths/login",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "api",
                "v1",
                "auths",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res && res.data && res.data.accessToken) {",
                  "        pm.collectionVariables.set('access_token', res.data.accessToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "description": "Refresh access_token using refresh_token cookie",
            "url": {
              "raw": "{{baseurl}}/api/v1/auths/refresh-token",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "api",
                "v1",
                "auths",
                "refresh-token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "description": "Get current user profile (requires access_token cookie)",
            "url": {
              "raw": "{{baseurl}}/api/v1/auths/profile",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "api",
                "v1",
                "auths",
                "profile"
              ]
            }
          },
          "response": []
        }
      ]
    },
