{
  "info": {
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "name": "EcoFarm Blockchain API",
    "description": "API testing collection. Base URL: http://localhost:8080/ecofarm_backend-1.0-SNAPSHOT"
  },
  "variable": [
    {
      "key": "baseurl",
      "value": "http://localhost:8080/ecofarm_backend-1.0-SNAPSHOT",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "a@b.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "x",
      "type": "string"
    },
    {
      "key": "batchId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "anchorId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "code",
      "value": "TEST123",
      "type": "string"
    },
    {
      "key": "reason",
      "value": "Sản phẩm lỗi cần thu hồi",
      "type": "string"
    },
    {
      "key": "onlyMismatch",
      "value": "false",
      "type": "string"
    },
    {
      "key": "page",
      "value": "0",
      "type": "string"
    },
    {
      "key": "size",
      "value": "20",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (responseCode.code === 200) {",
                  "    pm.environment.set(\"access_token\", pm.response.json().data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            },
            "description": "Get access and refresh tokens",
            "url": {
              "raw": "{{baseurl}}/api/v1/auths/login",
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Refresh the current access token",
            "url": {
              "raw": "{{baseurl}}/api/v1/auths/refresh-token",
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "description": "Get current user profile",
            "url": {
              "raw": "{{baseurl}}/api/v1/auths/profile",
              "query": []
            }
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints"
    },
    {
      "name": "Blockchain Admin",
      "item": [
        {
          "name": "Get All Anchors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/api/v1/admin/anchors",
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Get Reconciliation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/api/v1/admin/reconciliation?onlyMismatch={{onlyMismatch}}&page={{page}}&size={{size}}",
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Get Batch Anchor Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/api/v1/batches/{{batchId}}/anchor-status",
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Retry Anchor",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/api/v1/admin/anchors/{{anchorId}}/retry",
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Recall Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"reason\":\"{{reason}}\"}"
            },
            "url": {
              "raw": "{{baseurl}}/api/v1/batches/{{batchId}}/recall",
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Get Proof Bundle",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/api/v1/batches/{{batchId}}/proof-bundle",
              "query": []
            }
          },
          "response": []
        }
      ],
      "description": "Blockchain administration endpoints"
    },
    {
      "name": "Verification",
      "item": [
        {
          "name": "Get Public Trace",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/api/v1/public/trace/{{code}}",
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Verify Public Trace",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/api/v1/public/trace/{{code}}/verify",
              "query": []
            }
          },
          "response": []
        }
      ],
      "description": "Public verification and tracing endpoints"
    }
  ]
}
