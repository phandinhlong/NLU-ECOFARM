        {
          "name": "03.3 Cap nhat giong",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{varCode}}\",\n  \"name\": \"Dua luoi Postman (updated)\",\n  \"daysPollinationToHarvest\": 80,\n  \"minBrix\": 12.0,\n  \"minIsolationDays\": 10,\n  \"version\": {{varietyVersion}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/varieties/{{varietyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["varieties", "{{varietyId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('varietyVersion', b.data.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "03.4 Validation: so ngay > 365 (mong doi 400)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"VAR-PM-BAD\",\n  \"name\": \"Sai so ngay\",\n  \"daysPollinationToHarvest\": 999\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/varieties", "host": ["{{baseUrl}}"], "path": ["varieties"] }
          }
        }
      ]
    },
    {
      "name": "04 - Chung nhan (FR-MST-003)",
      "item": [
        {
          "name": "04.1 Danh sach theo nha mang",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/certificates?page=0&size=20&greenhouseId={{greenhouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["certificates"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "greenhouseId", "value": "{{greenhouseId}}" }
              ]
            }
          }
        },
        {
          "name": "04.2 Canh bao het han 30 ngay",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/certificates?expiringInDays=30",
              "host": ["{{baseUrl}}"],
              "path": ["certificates"],
              "query": [{ "key": "expiringInDays", "value": "30" }]
            }
          }
        },
        {
          "name": "04.3 Tao chung nhan",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"greenhouseId\": {{greenhouseId}},\n  \"certType\": \"VIETGAP\",\n  \"certNo\": \"{{certNo}}\",\n  \"validFrom\": \"2026-01-01\",\n  \"validTo\": \"2026-12-31\",\n  \"fileKey\": \"certificates/vietgap-2026.pdf\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/certificates", "host": ["{{baseUrl}}"], "path": ["certificates"] }
          }
        },
        {
          "name": "04.4 Trung so chung nhan (mong doi 1014)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code 1014', () => pm.expect(b.code).to.eql(1014));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"greenhouseId\": {{greenhouseId}},\n  \"certType\": \"GLOBALGAP\",\n  \"certNo\": \"{{certNo}}\",\n  \"validFrom\": \"2026-01-01\",\n  \"validTo\": \"2026-12-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/certificates", "host": ["{{baseUrl}}"], "path": ["certificates"] }
          }
        },
        {
          "name": "04.5 Ngay hieu luc sai (mong doi 1012)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
