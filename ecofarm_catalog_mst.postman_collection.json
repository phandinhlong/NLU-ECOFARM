                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"greenhouseId\": {{greenhouseId}},\n  \"certType\": \"VIETGAP\",\n  \"certNo\": \"CERT-PM-BAD-DATE\",\n  \"validFrom\": \"2026-12-31\",\n  \"validTo\": \"2026-01-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/certificates", "host": ["{{baseUrl}}"], "path": ["certificates"] }
          }
