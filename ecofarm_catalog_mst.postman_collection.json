{
  "info": {
    "name": "EcoFarm - MST Catalog (nha mang / giong / chung nhan)",
    "description": "Bo test cho cac chuc nang FR-MST-001..004. Chay request '00 - Login' dau tien de lay cookie (access_token) roi test cac request con lai. Yeu cau role ADMIN hoac ENGINEER.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/ecofarm_backend-1.0-SNAPSHOT/api/v1" },
    { "key": "email", "value": "ngminh6112005@gmail.com" },
    { "key": "password", "value": "Minh06112005" },
    { "key": "greenhouseId", "value": "" },
    { "key": "greenhouseVersion", "value": "" },
    { "key": "varietyId", "value": "" },
    { "key": "varietyVersion", "value": "" },
    { "key": "certNo", "value": "CERT-PM-01" },
    { "key": "ghCode", "value": "GH-PM-01" },
    { "key": "varCode", "value": "VAR-PM-01" }
  ],
  "item": [
    {
      "name": "00 - Login (lay cookie)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login 200', () => pm.response.to.have.status(200));",
              "pm.test('isSuccess = true', () => pm.expect(pm.response.json().isSuccess).to.eql(true));",
              "// Postman tu dong luu cookie access_token / refresh_token cho host localhost:8080"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/auths/login", "host": ["{{baseUrl}}"], "path": ["auths", "login"] }
      }
    },
    {
      "name": "01 - Profile (kiem tra role)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const b = pm.response.json();",
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const roles = (b.data && b.data.role) || [];",
              "pm.test('Co role ADMIN hoac ENGINEER', () => pm.expect(roles.some(r => r === 'ADMIN' || r === 'ENGINEER')).to.eql(true));",
              "console.log('Roles:', roles.join(', '));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/auths/profile", "host": ["{{baseUrl}}"], "path": ["auths", "profile"] }
      }
    },
    {
      "name": "02 - Nha mang (FR-MST-001)",
      "item": [
        {
          "name": "02.1 Danh sach",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/greenhouses?page=0&size=20&status=&q=",
              "host": ["{{baseUrl}}"],
              "path": ["greenhouses"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "status", "value": "" },
                { "key": "q", "value": "" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "02.2 Tao nha mang",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('is_active = true', () => pm.expect(b.data.active).to.eql(true));",
                  "pm.collectionVariables.set('greenhouseId', b.data.id);",
                  "pm.collectionVariables.set('greenhouseVersion', b.data.version);",
                  "console.log('greenhouseId =', b.data.id, 'version =', b.data.version);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{ghCode}}\",\n  \"name\": \"Nha mang Postman\",\n  \"gpsLat\": 10.123456,\n  \"gpsLng\": 106.123456,\n  \"areaM2\": 500.5,\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/greenhouses", "host": ["{{baseUrl}}"], "path": ["greenhouses"] }
          }
        },
        {
          "name": "02.3 Chi tiet",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/greenhouses/{{greenhouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["greenhouses", "{{greenhouseId}}"]
            }
          }
        },
        {
          "name": "02.4 Cap nhat (dung version)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('greenhouseVersion', b.data.version);",
                  "console.log('version moi =', b.data.version);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{ghCode}}\",\n  \"name\": \"Nha mang Postman (updated)\",\n  \"gpsLat\": 10.2,\n  \"gpsLng\": 106.3,\n  \"areaM2\": 600,\n  \"status\": \"MAINTENANCE\",\n  \"version\": {{greenhouseVersion}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/greenhouses/{{greenhouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["greenhouses", "{{greenhouseId}}"]
            }
          }
        },
        {
          "name": "02.5 Cap nhat sai version (mong doi 1011)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('1009/1011 conflict', () => pm.expect([409, 400]).to.include(pm.response.code));",
                  "pm.test('code 1011', () => pm.expect(b.code).to.eql(1011));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{ghCode}}\",\n  \"name\": \"Sai version\",\n  \"version\": 999\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/greenhouses/{{greenhouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["greenhouses", "{{greenhouseId}}"]
            }
          }
        },
        {
          "name": "02.6 Trung ma (mong doi 1009)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('code 1009', () => pm.expect(b.code).to.eql(1009));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{ghCode}}\",\n  \"name\": \"Trung ma\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/greenhouses", "host": ["{{baseUrl}}"], "path": ["greenhouses"] }
          }
        }
      ]
    },
    {
      "name": "03 - Giong dua (FR-MST-002)",
      "item": [
        {
          "name": "03.1 Danh sach",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/varieties?page=0&size=20&q=",
