              "raw": "{\n  \"code\": \"{{varCode}}\",\n  \"name\": \"Dua luoi Postman\",\n  \"daysPollinationToHarvest\": 75,\n  \"minBrix\": 11.5,\n  \"minIsolationDays\": 7\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/varieties", "host": ["{{baseUrl}}"], "path": ["varieties"] }
