<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.org">
<hibernate-configuration>
    <session-factory>
        <!-- Cấu hình kết nối PostgreSQL -->
        <property name="connection.driver_class">org.postgresql.Driver</property>
        <property name="connection.url">jdbc:postgresql://localhost:5432/ecofarm</property>
        <property name="connection.username">ecofarm</property>
        <property name="connection.password">ecofarm123</property>

        <!-- Phương ngữ (Dialect) của PostgreSQL -->
        <property name="dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Tự động tạo/cập nhật bảng trong DB: create, update, validate, create-drop -->
        <property name="hbm2ddl.auto">update</property>

        <!-- Hiển thị câu lệnh SQL ra console -->
        <property name="show_sql">true</property>
        <property name="format_sql">true</property>

        <!-- Khai báo Entity (Mapped classes) -->

    </session-factory>
</hibernate-configuration>
